{
  "name": "tachlit-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Tachlit PWA \u2013 web version of the Tachlit Android app",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.sw.json",
    "deploy": "npm run build && firebase deploy --only hosting:app",
    "fake-server": "node fake-server/server.mjs",
    "dev:fake": "VITE_API_BASE_URL=http://localhost:4010 vite"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.3.0",
    "firebase": "^13.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "msw": "^3.0.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1"
  },
  "allowScripts": {
    "@firebase/util": false,
    "protobufjs": false
  }
}
