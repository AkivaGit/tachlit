# Tachlit web app settings. Everything here is PUBLIC (it ends up in the app
# that anyone can download) – never put secrets here.

# The Tachlit server (same as the Android app).
VITE_API_BASE_URL=https://tachlit.onrender.com

# Firebase web app (Firebase console → Project settings → Your apps → Web app).
# Push notifications stay off until all of these and the push key are filled in.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=tachlit-2efd4
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Web push key (Firebase console → Project settings → Cloud Messaging →
# Web Push certificates → Key pair). Public key only.
VITE_FIREBASE_VAPID_KEY=
